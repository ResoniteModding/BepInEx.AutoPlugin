<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>netstandard2.0</TargetFramework>

        <VersionPrefix>2.1.0</VersionPrefix>
        <VersionSuffix></VersionSuffix>

        <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
        <IncludeBuildOutput>false</IncludeBuildOutput>
        <DevelopmentDependency>true</DevelopmentDependency>
        <SuppressDependenciesWhenPacking>true</SuppressDependenciesWhenPacking>

        <RepositoryType>git</RepositoryType>
        <RepositoryUrl>https://github.com/ResoniteModding/BepInEx.AutoPlugin</RepositoryUrl>
        <PackageProjectUrl>https://github.com/ResoniteModding/BepInEx.AutoPlugin</PackageProjectUrl>
        <PackageLicenseExpression>LGPL-3.0-or-later</PackageLicenseExpression>
        <PackageId>BepInEx.AutoPlugin</PackageId>
        <Description>Incremental C# source generator that generates BepInPlugin attribute and static plugin info for you.</Description>
        <Authors>ResoniteModding, Hamunii, BepInEx</Authors>
        <PackageReadmeFile>README.md</PackageReadmeFile>
        <PackageTags>BepInEx;PluginInfoProps;$(PackageTags)</PackageTags>

        <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>

        <PublishRepositoryUrl>true</PublishRepositoryUrl>
        <EmbedUntrackedSources>true</EmbedUntrackedSources>
    </PropertyGroup>

    <ItemGroup>
        <None Include="../README.md" Pack="true" PackagePath="/" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="4.14.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.CodeAnalysis.Analyzers" Version="3.11.0" PrivateAssets="all" />
        <PackageReference Include="Microsoft.SourceLink.GitHub" Version="8.0.0" PrivateAssets="All" />

        <PackageReference Include="PolySharp" Version="1.15.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>

        <None Include="$(TargetPath)"
            Pack="true"
            PackagePath="analyzers/dotnet/cs"
            Visible="false" />

        <None Include="BepInEx.AutoPlugin.props"
            Pack="true"
            PackagePath="build"
            Visible="false" />
    </ItemGroup>

    <PropertyGroup Condition="'$(GITHUB_ACTIONS)' == 'true'">
        <ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
    </PropertyGroup>

</Project>
